@startuml
skinparam actorStyle awesome
left to right direction
skinparam packageStyle rectangle

actor "Administrador" as Admin
actor "Recepcionista" as Recep
actor "Cliente" as Cliente

rectangle "Módulo de Seguridad y Accesos (Sprint 1)" {
    usecase "CU-01: Iniciar Sesión" as CU01
    usecase "CU-01.1: Autenticación con Google" as CU01_Google
    usecase "CU-01.2: Registrarse como Cliente" as CU01_Reg
    usecase "CU-01.3: Cerrar Sesión" as CU01_Logout
    usecase "CU-02: Gestionar Usuarios" as CU02
    usecase "CU-02.1: Crear Usuario Personal / Cliente" as CU02_Crear
    usecase "CU-02.2: Modificar Datos y Asignar Roles" as CU02_Editar
    usecase "CU-02.3: Activar / Desactivar Cuenta" as CU02_Estado
}

Admin --> CU01
Admin --> CU01_Logout
Admin --> CU02
CU02 ..> CU02_Crear : <<include>>
CU02 ..> CU02_Editar : <<include>>
CU02 ..> CU02_Estado : <<include>>

Recep --> CU01
Recep --> CU01_Logout

Cliente --> CU01
Cliente --> CU01_Google
Cliente --> CU01_Reg
Cliente --> CU01_Logout
@enduml
