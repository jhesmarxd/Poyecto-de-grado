@startuml
skinparam linetype ortho

entity "users" as users {
    * id : bigint <<PK>>
    --
    * name : varchar(255)
    * email : varchar(255) <<UK>>
    * rol : enum('admin','recepcionista','cliente')
    telefono : varchar(20)
    * estado : boolean
}

entity "canchas" as canchas {
    * id : bigint <<PK>>
    --
    * nombre : varchar(100)
    * precio_por_hora : decimal(8,2)
    * estado : varchar(20)
}

entity "horarios" as horarios {
    * id : bigint <<PK>>
    --
    * cancha_id : bigint <<FK>>
    * dia_semana : tinyint
    * hora_inicio : time
    * hora_fin : time
}

entity "balones" as balones {
    * id : bigint <<PK>>
    --
    * nombre : varchar(100)
    * precio_alquiler : decimal(8,2)
    * stock_disponible : int
}

entity "reservas" as reservas {
    * id : bigint <<PK>>
    --
    * user_id : bigint <<FK>>
    * cancha_id : bigint <<FK>>
    * horario_id : bigint <<FK>>
    balon_id : bigint <<FK>>
    * fecha : date
    * hora_inicio_reserva : time
    * hora_fin_reserva : time
    * monto_total : decimal(8,2)
    * estado : enum('pendiente','confirmada','en_curso','completada','cancelada')
    * origen : enum('web','recepcion','chatbot')
    checkin_at : timestamp
    checkout_at : timestamp
    created_at : timestamp
    updated_at : timestamp
}

entity "google_calendar_events" as gcal {
    * id : bigint <<PK>>
    --
    * reserva_id : bigint <<FK>>
    * google_event_id : varchar(255)
    * sync_status : varchar(50)
    created_at : timestamp
    updated_at : timestamp
}

entity "configuracion_reservas" as config {
    * id : bigint <<PK>>
    --
    * minutos_tolerancia_checkin : int
    * horas_anticipacion_minima : int
    * dias_anticipacion_maxima : int
    * limite_reservas_activas_por_cliente : int
}

users ||--o{ reservas : "1:N (solicita)"
canchas ||--o{ reservas : "1:N (es reservada)"
horarios ||--o{ reservas : "1:N (turno horario)"
balones ||--o{ reservas : "0..1:N (alquiler opcional)"
reservas ||--o| gcal : "1:0..1 (evento sincronizado)"
@enduml

