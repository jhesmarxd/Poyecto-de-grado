APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost
APP_TIMEZONE=America/La_Paz

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# ----------------------------------------------------------------------------
# Chatbot (Sprint 5)
# El motor local por reglas funciona sin configuración adicional.
# Opcional: configura Gemini para extraer intención y entidades en JSON.
# El backend conserva el control de disponibilidad, precios y reservas.
# Si la API no está configurada o falla, se usa el motor local.
#
# Para usar Gemini:
#   1. Crea una API key gratis en https://aistudio.google.com/apikey
#   2. CHATBOT_PROVIDER=gemini
#   3. GEMINI_API_KEY=tu_clave_real
#   4. CHATBOT_MODEL=gemini-3.6-flash (o el modelo que prefieras)
#   5. Ejecuta: php artisan config:clear
# ----------------------------------------------------------------------------
CHATBOT_NOMBRE=WallyBot
# Déjalo vacío para usar exclusivamente el motor local gratuito (sin API ni tokens).
CHATBOT_PROVIDER=
GEMINI_API_KEY=
CHATBOT_API_KEY=
CHATBOT_MODEL=
CHATBOT_RATE_LIMIT_GUEST=10
CHATBOT_RATE_LIMIT_AUTHENTICATED=30
CHATBOT_TELEFONO=
CHATBOT_DIRECCION=

# ----------------------------------------------------------------------------
# Google OAuth / Calendar
# ----------------------------------------------------------------------------
# No guardes secretos reales en este archivo. Configúralos solamente en .env.
GOOGLE_AUTH_CLIENT_ID=
GOOGLE_AUTH_CLIENT_SECRET=
GOOGLE_AUTH_REDIRECT_URI="${APP_URL}/auth/google/callback"

# Se puede usar otro cliente OAuth para Calendar. Si ID y secreto se dejan
# vacíos, el sistema reutiliza las credenciales de GOOGLE_AUTH_*.
GOOGLE_CALENDAR_CLIENT_ID=
GOOGLE_CALENDAR_CLIENT_SECRET=
GOOGLE_CALENDAR_REDIRECT_URI="${APP_URL}/admin/integraciones/google-calendar/callback"
GOOGLE_CALENDAR_ID=primary
# Recordatorios popup: 1 día, 2 horas y 30 minutos antes.
GOOGLE_CALENDAR_REMINDERS=1440,120,30
# Mantener false hasta conectar la cuenta y ejecutar el worker de colas.
GOOGLE_CALENDAR_ENABLED=false
